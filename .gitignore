# IDE / venv / cache
.venv/
.idea/
__pycache__/
*.pyc

# Runtime data is not versioned: user uploads and generated results
data/inputs/*
data/outputs/*
data/processed/*

# ...except placeholders and the material master (not user-uploaded)
!data/inputs/.keep
!data/outputs/.keep
!data/inputs/Artikel & Materialien FGR+.XLSX